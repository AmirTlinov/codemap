{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/anchors.schema.json",
  "title": "codemap semantic anchors",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "domain": { "$ref": "#/$defs/domain" },
    "domains": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/domain" }
    },
    "owns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "does_not_own": {
      "type": "array",
      "items": { "type": "string" }
    },
    "concepts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/concept" }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "boundaries": { "$ref": "#/$defs/boundaries" },
    "verification": { "$ref": "#/$defs/verification" },
    "proof": { "$ref": "#/$defs/proof" }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "purpose": { "type": "string" }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string" },
        "kind": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "invariants": {
          "type": "array",
          "items": { "type": "string" }
        },
        "derives_from": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reads": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "consumed_by": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbidden": {
          "type": "array",
          "items": { "$ref": "#/$defs/boundary_rule" }
        }
      }
    },
    "boundary_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "recovery": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["forbidden", "warn", "warning"]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changed": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
