{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/ls.schema.json",
  "title": "codemap structural ls report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "prelude",
    "path",
    "mode",
    "anchor",
    "directory",
    "boundary_facts",
    "edges",
    "hidden",
    "next"
  ],
  "properties": {
    "kind": { "const": "ls_report" },
    "schema_version": { "const": "5" },
    "prelude": { "$ref": "#/$defs/map_prelude" },
    "path": { "type": "string" },
    "mode": { "type": "string", "enum": ["file", "directory", "missing"] },
    "anchor": {
      "anyOf": [{ "$ref": "#/$defs/file_summary" }, { "type": "null" }]
    },
    "directory": {
      "type": "array",
      "items": { "$ref": "#/$defs/directory_surface" }
    },
    "boundary_facts": { "$ref": "#/$defs/boundary_facts" },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_edge" }
    },
    "hidden": {
      "type": "array",
      "items": { "$ref": "#/$defs/hidden_group" }
    },
    "next": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "map_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "cwd", "cwd_rel", "git_root", "vcs", "head", "branch", "remote", "worktree", "freshness", "unknowns"],
      "properties": {
        "root": { "type": "string" },
        "cwd": { "type": "string" },
        "cwd_rel": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "git_root": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "vcs": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "head": { "$ref": "#/$defs/head_prelude" },
        "branch": { "$ref": "#/$defs/branch_prelude" },
        "remote": { "$ref": "#/$defs/remote_prelude" },
        "worktree": { "$ref": "#/$defs/worktree_prelude" },
        "freshness": { "$ref": "#/$defs/freshness_prelude" },
        "unknowns": { "type": "array", "items": { "$ref": "#/$defs/prelude_unknown" } }
      }
    },
    "head_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oid", "short", "detached", "unborn"],
      "properties": {
        "oid": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "short": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "detached": { "type": "boolean" },
        "unborn": { "type": "boolean" }
      }
    },
    "branch_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "upstream", "upstream_gone", "ahead", "behind"],
      "properties": {
        "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "upstream": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "upstream_gone": { "type": "boolean" },
        "ahead": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "behind": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },
    "remote_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display", "sanitized_url"],
      "properties": {
        "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "display": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "sanitized_url": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "worktree_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "staged", "unstaged", "untracked", "conflicted", "renamed", "deleted", "typechanged"],
      "properties": {
        "clean": { "type": "boolean" },
        "staged": { "type": "integer", "minimum": 0 },
        "unstaged": { "type": "integer", "minimum": 0 },
        "untracked": { "type": "integer", "minimum": 0 },
        "conflicted": { "type": "integer", "minimum": 0 },
        "renamed": { "type": "integer", "minimum": 0 },
        "deleted": { "type": "integer", "minimum": 0 },
        "typechanged": { "type": "integer", "minimum": 0 }
      }
    },
    "freshness_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_used", "remote_refs", "remote_currentness", "fetch_head_mtime", "evidence"],
      "properties": {
        "network_used": { "type": "boolean" },
        "remote_refs": { "type": "string", "enum": ["local_only", "not_applicable"] },
        "remote_currentness": { "type": "string", "enum": ["unknown"] },
        "fetch_head_mtime": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "prelude_unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "effect"],
      "properties": {
        "kind": { "type": "string" },
        "effect": { "type": "string" }
      }
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "evidence_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "kind"],
      "properties": {
        "path": { "type": "string" },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "line_end": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "kind": { "type": "string" }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "exported", "line_start", "line_end"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "exported": { "type": "boolean" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "file_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "package",
        "language",
        "lines",
        "roles",
        "symbols",
        "exports",
        "imports",
        "imported_by_count"
      ],
      "properties": {
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "package": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "language": { "type": "string" },
        "lines": { "type": "integer", "minimum": 0 },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/symbol" }
        },
        "exports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imported_by_count": { "type": "integer", "minimum": 0 }
      }
    },
    "directory_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "role",
        "evidence",
        "strength",
        "count",
        "examples",
        "hidden_count"
      ],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "role": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "count": { "type": "integer", "minimum": 0 },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hidden_count": { "type": "integer", "minimum": 0 }
      }
    },
    "boundary_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction_files", "protected_looking_paths", "repo_local_guard_files"],
      "properties": {
        "instruction_files": { "type": "array", "items": { "$ref": "#/$defs/boundary_fact" } },
        "protected_looking_paths": { "type": "array", "items": { "$ref": "#/$defs/boundary_fact" } },
        "repo_local_guard_files": { "type": "array", "items": { "$ref": "#/$defs/boundary_fact" } }
      }
    },
    "boundary_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "evidence", "effect"],
      "properties": {
        "path": { "type": "string" },
        "evidence": { "type": "string" },
        "effect": { "type": "string" }
      }
    },
    "structural_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "evidence", "strength", "locations"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string" },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_location" }
        }
      }
    },
    "hidden_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count", "expand"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "expand": { "type": "string" }
      }
    }
  }
}
