{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/where.schema.json",
  "title": "codemap structural where report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "build_identity",
    "query",
    "kind_filter",
    "total_matches",
    "observations",
    "definitions",
    "soft_suggestions",
    "unknowns",
    "hidden",
    "expand"
  ],
  "properties": {
    "kind": { "const": "where_report" },
    "schema_version": { "const": "6" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "query": { "type": "string" },
    "kind_filter": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "total_matches": { "type": "integer", "minimum": 0 },
    "observations": { "$ref": "#/$defs/observation_ledger" },
    "definitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/where_definition" }
    },
    "soft_suggestions": {
      "type": "array",
      "items": { "$ref": "#/$defs/where_suggestion" }
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknown" }
    },
    "hidden": {
      "type": "array",
      "items": { "$ref": "#/$defs/hidden_group" }
    },
    "expand": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "coverage_reason": {
      "type": "string",
      "enum": [
        "anchor_not_indexed",
        "dynamic_env_lookup",
        "dynamic_import_flow",
        "dynamic_runtime_registration",
        "incomplete_traversal",
        "reexport_flow",
        "rust_include_flow",
        "unsupported_construct",
        "unsupported_language",
        "unclassified_coverage_gap",
        "verification_relation_flow"
      ]
    },
    "coverage_closure": {
      "type": "string",
      "enum": ["closed", "open", "unavailable"]
    },
    "coverage_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "extractor_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor_id", "version", "language", "constructs"],
      "properties": {
        "extractor_id": { "type": "string" },
        "version": { "type": "string" },
        "language": { "type": "string" },
        "constructs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "unsupported_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "construct"],
      "properties": {
        "file": { "type": "string" },
        "construct": { "type": "string" },
        "location": { "$ref": "#/$defs/coverage_location" }
      }
    },
    "coverage_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/coverage_reason" },
        "location": { "$ref": "#/$defs/coverage_location" },
        "missing_surface": { "type": "string" }
      }
    },
    "observed_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "closure", "reasons", "certificate_id"],
      "properties": {
        "observed": { "type": "integer", "minimum": 0 },
        "closure": { "$ref": "#/$defs/coverage_closure" },
        "reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverage_reason" },
          "uniqueItems": true
        },
        "certificate_id": {
          "type": "string",
          "pattern": "^coverage-v1:[0-9a-f]{64}$"
        }
      }
    },
    "coverage_horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "scope",
        "count",
        "shown",
        "hidden",
        "expand",
        "unsupported",
        "dynamic"
      ],
      "properties": {
        "group": { "type": "string" },
        "scope": { "type": "string" },
        "count": { "$ref": "#/$defs/observed_count" },
        "shown": { "type": "integer", "minimum": 0 },
        "hidden": { "type": "integer", "minimum": 0 },
        "expand": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "unsupported": {
          "type": "array",
          "items": { "$ref": "#/$defs/unsupported_observation" }
        },
        "dynamic": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverage_stop" }
        }
      }
    },
    "coverage_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "query_kind",
        "scope",
        "snapshot",
        "observed_facts",
        "eligible_files",
        "visited_files",
        "excluded_files_by_reason",
        "extractor_capabilities",
        "unsupported",
        "dynamic_stops",
        "unresolved_stops",
        "external_stops",
        "closure",
        "reasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^coverage-v1:[0-9a-f]{64}$"
        },
        "query_kind": { "type": "string" },
        "scope": { "type": "string" },
        "snapshot": { "type": "string" },
        "observed_facts": { "type": "integer", "minimum": 0 },
        "eligible_files": { "type": "integer", "minimum": 0 },
        "visited_files": { "type": "integer", "minimum": 0 },
        "excluded_files_by_reason": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/coverage_reason" },
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        },
        "extractor_capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/extractor_capability" },
          "uniqueItems": true
        },
        "unsupported": {
          "type": "array",
          "items": { "$ref": "#/$defs/unsupported_observation" },
          "uniqueItems": true
        },
        "dynamic_stops": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverage_stop" },
          "uniqueItems": true
        },
        "unresolved_stops": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverage_stop" },
          "uniqueItems": true
        },
        "external_stops": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverage_stop" },
          "uniqueItems": true
        },
        "closure": { "$ref": "#/$defs/coverage_closure" },
        "reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverage_reason" },
          "uniqueItems": true
        }
      }
    },
    "observation_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificates", "horizons"],
      "properties": {
        "certificates": {
          "type": "object",
          "propertyNames": {
            "pattern": "^coverage-v1:[0-9a-f]{64}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/coverage_certificate"
          }
        },
        "horizons": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverage_horizon" }
        }
      }
    },
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver",
        "cache_format",
        "schema_manifest_version",
        "executable_path",
        "binary_sha256",
        "binary_sha256_state",
        "source_commit",
        "dirty_build"
      ],
      "properties": {
        "semver": { "type": "string" },
        "cache_format": { "type": "string" },
        "schema_manifest_version": { "type": "integer", "minimum": 1 },
        "executable_path": { "type": "string" },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256_state": {
          "type": "string",
          "enum": ["computed", "not_requested", "unavailable"]
        },
        "source_commit": { "type": ["string", "null"] },
        "dirty_build": { "type": ["boolean", "null"] }
      }
    },
    "where_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor",
        "consumers",
        "consumers_total",
        "incoming",
        "verification",
        "observations",
        "hidden",
        "expand"
      ],
      "properties": {
        "anchor": { "$ref": "#/$defs/file_summary" },
        "consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "consumers_total": { "$ref": "#/$defs/observed_count" },
        "incoming": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "verification": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "observations": { "$ref": "#/$defs/observation_ledger" },
        "hidden": {
          "type": "array",
          "items": { "$ref": "#/$defs/hidden_group" }
        },
        "expand": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "where_suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "defined_in", "definition_count", "expand"],
      "properties": {
        "name": { "type": "string" },
        "defined_in": { "type": "string" },
        "definition_count": { "type": "integer", "minimum": 0 },
        "expand": { "type": "string" }
      }
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "evidence_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "kind"],
      "properties": {
        "path": { "type": "string" },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "line_end": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "kind": { "type": "string" }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "exported", "line_start", "line_end"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "exported": { "type": "boolean" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "file_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "package",
        "language",
        "lines",
        "roles",
        "symbols",
        "exports",
        "imports",
        "imported_by"
      ],
      "properties": {
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "package": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "language": { "type": "string" },
        "lines": { "type": "integer", "minimum": 0 },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/symbol" }
        },
        "exports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imported_by": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["counted", "proven_zero", "unknown"] },
            "value": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "structural_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "evidence", "strength", "locations"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string" },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_location" }
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "line_start", "reason", "effect", "expand"],
      "properties": {
        "kind": { "type": "string" },
        "path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "reason": { "type": "string" },
        "effect": { "type": "string" },
        "expand": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "hidden_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count", "expand"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "expand": { "type": "string" }
      }
    }
  }
}
