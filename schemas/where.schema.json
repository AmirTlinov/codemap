{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/where.schema.json",
  "title": "codemap structural where report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "query",
    "kind_filter",
    "total_matches",
    "definitions",
    "soft_suggestions",
    "unknowns",
    "hidden",
    "expand"
  ],
  "properties": {
    "kind": { "const": "where_report" },
    "schema_version": { "const": "2" },
    "query": { "type": "string" },
    "kind_filter": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "total_matches": { "type": "integer", "minimum": 0 },
    "definitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/where_definition" }
    },
    "soft_suggestions": {
      "type": "array",
      "items": { "$ref": "#/$defs/where_suggestion" }
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknown" }
    },
    "hidden": {
      "type": "array",
      "items": { "$ref": "#/$defs/hidden_group" }
    },
    "expand": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "where_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "consumers", "consumers_total", "hidden", "expand"],
      "properties": {
        "anchor": { "$ref": "#/$defs/file_summary" },
        "consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "consumers_total": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["counted", "proven_zero", "unknown"] },
            "value": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string" }
          }
        },
        "hidden": {
          "type": "array",
          "items": { "$ref": "#/$defs/hidden_group" }
        },
        "expand": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "where_suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "defined_in", "definition_count", "expand"],
      "properties": {
        "name": { "type": "string" },
        "defined_in": { "type": "string" },
        "definition_count": { "type": "integer", "minimum": 0 },
        "expand": { "type": "string" }
      }
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "evidence_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "kind"],
      "properties": {
        "path": { "type": "string" },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "line_end": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "kind": { "type": "string" }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "exported", "line_start", "line_end"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "exported": { "type": "boolean" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "file_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "package",
        "language",
        "lines",
        "roles",
        "symbols",
        "exports",
        "imports",
        "imported_by"
      ],
      "properties": {
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "package": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "language": { "type": "string" },
        "lines": { "type": "integer", "minimum": 0 },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/symbol" }
        },
        "exports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imported_by": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["counted", "proven_zero", "unknown"] },
            "value": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "structural_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "evidence", "strength", "locations"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string" },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_location" }
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "line_start", "reason", "effect", "expand"],
      "properties": {
        "kind": { "type": "string" },
        "path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "reason": { "type": "string" },
        "effect": { "type": "string" },
        "expand": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "hidden_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count", "expand"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "expand": { "type": "string" }
      }
    }
  }
}
