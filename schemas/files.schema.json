{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/ctx/schemas/files.schema.json",
  "title": "ctx files report",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "path", "files", "count"],
  "properties": {
    "kind": { "const": "files" },
    "schema_version": { "const": "1" },
    "path": { "type": "string" },
    "files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "count": { "type": "integer", "minimum": 0 }
  }
}
