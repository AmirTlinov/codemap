{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/ctx/schemas/locate.schema.json",
  "title": "ctx location candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "task", "candidates"],
  "properties": {
    "kind": { "const": "location_candidates" },
    "schema_version": { "const": "1" },
    "task": { "type": "string" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/locate_candidate" }
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "domain_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "locate_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "score",
        "task_kind",
        "confidence",
        "reasons",
        "start_command"
      ],
      "properties": {
        "domain": { "$ref": "#/$defs/domain_ref" },
        "score": { "type": "number" },
        "task_kind": { "type": "string" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "start_command": { "type": "string" }
      }
    }
  }
}
