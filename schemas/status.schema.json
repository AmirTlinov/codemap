{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/status.schema.json",
  "title": "codemap status report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "build_identity",
    "path_identity",
    "executable_mismatch",
    "root",
    "cwd",
    "vcs",
    "config",
    "config_errors",
    "nearest_agents",
    "cache_dir",
    "cache_state",
    "cache_strategy",
    "cache_artifacts",
    "scanner",
    "timings",
    "zero_footprint_default",
    "package_manager",
    "languages",
    "files_scanned",
    "files_reused",
    "domains",
    "scripts",
    "fingerprint",
    "boundary_findings",
    "map_quality",
    "unclassified_source_files",
    "unclassified_count"
  ],
  "properties": {
    "kind": { "const": "status_report" },
    "schema_version": { "const": "6" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "path_identity": { "$ref": "#/$defs/path_executable_identity" },
    "executable_mismatch": { "type": ["boolean", "null"] },
    "root": { "type": "string" },
    "cwd": { "type": "string" },
    "vcs": { "type": ["string", "null"] },
    "config": { "type": ["string", "null"] },
    "config_errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nearest_agents": { "type": ["string", "null"] },
    "cache_dir": { "type": "string" },
    "cache_state": {
      "type": "string",
      "enum": ["cold", "warm", "stale", "disabled"]
    },
    "cache_strategy": {
      "type": "string",
      "enum": ["full_scan", "warm_load", "partial_rescan", "disabled"]
    },
    "cache_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/cache_artifact" }
    },
    "scanner": { "$ref": "#/$defs/scan_stats" },
    "timings": { "$ref": "#/$defs/project_timings" },
    "zero_footprint_default": { "type": "boolean" },
    "package_manager": { "type": "string" },
    "languages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_scanned": { "type": "integer", "minimum": 0 },
    "files_reused": { "type": "integer", "minimum": 0 },
    "domains": {
      "type": "array",
      "items": { "$ref": "#/$defs/domain_status" }
    },
    "scripts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fingerprint": { "type": "string" },
    "boundary_findings": { "type": "integer", "minimum": 0 },
    "map_quality": {
      "type": "array",
      "items": { "$ref": "#/$defs/map_quality_warning" }
    },
    "unclassified_source_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unclassified_count": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver",
        "cache_format",
        "schema_manifest_version",
        "executable_path",
        "binary_sha256",
        "binary_sha256_state",
        "source_commit",
        "dirty_build"
      ],
      "properties": {
        "semver": { "type": "string" },
        "cache_format": { "type": "string" },
        "schema_manifest_version": { "type": "integer", "minimum": 1 },
        "executable_path": { "type": "string" },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256_state": {
          "type": "string",
          "enum": ["computed", "not_requested", "unavailable"]
        },
        "source_commit": { "type": ["string", "null"] },
        "dirty_build": { "type": ["boolean", "null"] }
      }
    },
    "path_executable_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable_path",
        "semver",
        "binary_sha256",
        "binary_sha256_state",
        "version_probe"
      ],
      "properties": {
        "executable_path": { "type": ["string", "null"] },
        "semver": { "type": ["string", "null"] },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256_state": {
          "type": "string",
          "enum": ["computed", "unavailable"]
        },
        "version_probe": {
          "type": "string",
          "enum": ["same_executable", "ok", "not_found", "unavailable"]
        }
      }
    },
    "cache_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "exists", "bytes", "fingerprint_match"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "status.json",
            "inventory.json",
            "graph.json",
            "fingerprints.json",
            "runtime-root.json"
          ]
        },
        "path": { "type": "string" },
        "exists": { "type": "boolean" },
        "bytes": { "type": ["integer", "null"], "minimum": 0 },
        "fingerprint_match": { "type": ["boolean", "null"] }
      }
    },
    "domain_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "config"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "config": { "type": ["string", "null"] }
      }
    },
    "scan_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_visited",
        "files_scanned",
        "files_skipped",
        "bytes_scanned",
        "ignored",
        "generated"
      ],
      "properties": {
        "files_visited": { "type": "integer", "minimum": 0 },
        "files_scanned": { "type": "integer", "minimum": 0 },
        "files_skipped": { "type": "integer", "minimum": 0 },
        "bytes_scanned": { "type": "integer", "minimum": 0 },
        "ignored": {
          "type": "array",
          "items": { "$ref": "#/$defs/scan_group" }
        },
        "generated": {
          "type": "array",
          "items": { "$ref": "#/$defs/scan_group" }
        }
      }
    },
    "scan_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count", "examples"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "map_quality_warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "count", "examples", "reason", "effect", "expand"],
      "properties": {
        "kind": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason": { "type": "string" },
        "effect": { "type": "string" },
        "expand": { "type": ["string", "null"] }
      }
    },
    "project_timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_ms",
        "scan_ms",
        "facts_ms",
        "cache_artifact_ms",
        "cache_write_ms",
        "total_ms"
      ],
      "properties": {
        "root_ms": { "type": "integer", "minimum": 0 },
        "scan_ms": { "type": "integer", "minimum": 0 },
        "facts_ms": { "type": "integer", "minimum": 0 },
        "cache_artifact_ms": { "type": "integer", "minimum": 0 },
        "cache_write_ms": { "type": "integer", "minimum": 0 },
        "total_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
