{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/proof.schema.json",
  "title": "codemap structural proof plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "kind",
    "schema_version",
    "build_identity",
    "prelude",
    "target",
    "changed",
    "proofs",
    "wiring",
    "verification_topology",
    "fallback",
    "unknowns",
    "hidden",
    "expand",
    "run_hint"
  ],
  "properties": {
    "agent": { "$ref": "#/$defs/agent_envelope" },
    "kind": { "const": "proof_plan" },
    "schema_version": { "const": "12" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "prelude": { "$ref": "#/$defs/map_prelude" },
    "target": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "proofs": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_surface" }
    },
    "coverage": {
      "anyOf": [{ "$ref": "#/$defs/proof_coverage_summary" }, { "type": "null" }]
    },
    "wiring": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_wiring_fact" }
    },
    "verification_topology": { "$ref": "#/$defs/verification_topology" },
    "fallback": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknown" }
    },
    "hidden": {
      "type": "array",
      "items": { "$ref": "#/$defs/hidden_group" }
    },
    "expand": {
      "type": "array",
      "items": { "type": "string" }
    },
    "run_hint": { "type": "string" }
  },
  "$defs": {
    "agent_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "report_kind", "report_version", "result", "scope", "snapshot", "horizon", "expands"],
      "properties": {
        "envelope_version": { "const": "1" },
        "report_kind": { "type": "string", "minLength": 1 },
        "report_version": { "type": "string", "minLength": 1 },
        "result": { "enum": ["success", "valid_empty_map", "invalid_anchor"] },
        "scope": { "type": "object" },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "identities"],
          "properties": {
            "state": { "enum": ["observed", "unavailable"] },
            "identities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        "horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "groups", "reasons", "certificate_count"],
          "properties": {
            "status": { "enum": ["closed", "open", "unavailable", "not_applicable"] },
            "groups": { "type": "integer", "minimum": 0 },
            "reasons": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "certificate_count": { "type": "integer", "minimum": 0 }
          }
        },
        "expands": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "uniqueItems": true
        }
      }
    },
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver",
        "cache_format",
        "schema_manifest_version",
        "executable_path",
        "binary_sha256",
        "binary_sha256_state",
        "source_commit",
        "dirty_build"
      ],
      "properties": {
        "semver": { "type": "string" },
        "cache_format": { "type": "string" },
        "schema_manifest_version": { "type": "integer", "minimum": 1 },
        "executable_path": { "type": "string" },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256_state": {
          "type": "string",
          "enum": ["computed", "not_requested", "unavailable"]
        },
        "source_commit": { "type": ["string", "null"] },
        "dirty_build": { "type": ["boolean", "null"] }
      }
    },
    "map_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "cwd", "cwd_rel", "git_root", "vcs", "head", "branch", "remote", "worktree", "freshness", "unknowns"],
      "properties": {
        "root": { "type": "string" },
        "cwd": { "type": "string" },
        "cwd_rel": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "git_root": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "vcs": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "head": { "$ref": "#/$defs/head_prelude" },
        "branch": { "$ref": "#/$defs/branch_prelude" },
        "remote": { "$ref": "#/$defs/remote_prelude" },
        "worktree": { "$ref": "#/$defs/worktree_prelude" },
        "freshness": { "$ref": "#/$defs/freshness_prelude" },
        "unknowns": { "type": "array", "items": { "$ref": "#/$defs/prelude_unknown" } }
      }
    },
    "head_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oid", "short", "detached", "unborn"],
      "properties": {
        "oid": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "short": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "detached": { "type": "boolean" },
        "unborn": { "type": "boolean" }
      }
    },
    "branch_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "upstream", "upstream_gone", "ahead", "behind"],
      "properties": {
        "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "upstream": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "upstream_gone": { "type": "boolean" },
        "ahead": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "behind": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },
    "remote_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display", "sanitized_url"],
      "properties": {
        "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "display": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "sanitized_url": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "worktree_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "staged", "unstaged", "untracked", "conflicted", "renamed", "deleted", "typechanged"],
      "properties": {
        "clean": { "type": "boolean" },
        "staged": { "type": "integer", "minimum": 0 },
        "unstaged": { "type": "integer", "minimum": 0 },
        "untracked": { "type": "integer", "minimum": 0 },
        "conflicted": { "type": "integer", "minimum": 0 },
        "renamed": { "type": "integer", "minimum": 0 },
        "deleted": { "type": "integer", "minimum": 0 },
        "typechanged": { "type": "integer", "minimum": 0 }
      }
    },
    "freshness_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_used", "remote_refs", "remote_currentness", "fetch_head_mtime", "evidence"],
      "properties": {
        "network_used": { "type": "boolean" },
        "remote_refs": { "type": "string", "enum": ["local_only", "not_applicable"] },
        "remote_currentness": { "type": "string", "enum": ["unknown"] },
        "fetch_head_mtime": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "prelude_unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "effect"],
      "properties": {
        "kind": { "type": "string" },
        "effect": { "type": "string" }
      }
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "evidence_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "kind"],
      "properties": {
        "path": { "type": "string" },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "line_end": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "kind": { "type": "string" }
      }
    },
    "proof_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "path",
        "target_anchor",
        "evidence",
        "strength",
        "reason",
        "locations"
      ],
      "properties": {
        "command": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "target_anchor": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "reason": { "type": "string" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_location" }
        }
      }
    },
    "hidden_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count", "expand"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "expand": { "type": "string" }
      }
    },
    "proof_coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_count",
        "runnable_deterministic",
        "evidence_only",
        "setup_support_only",
        "soft_only",
        "missing"
      ],
      "properties": {
        "changed_count": { "type": "integer", "minimum": 0 },
        "runnable_deterministic": {
          "type": "array",
          "items": { "$ref": "#/$defs/proof_covered_path" }
        },
        "evidence_only": {
          "type": "array",
          "items": { "$ref": "#/$defs/proof_covered_path" }
        },
        "setup_support_only": {
          "type": "array",
          "items": { "$ref": "#/$defs/proof_covered_path" }
        },
        "soft_only": {
          "type": "array",
          "items": { "$ref": "#/$defs/proof_covered_path" }
        },
        "missing": {
          "type": "array",
          "items": { "$ref": "#/$defs/proof_gap" }
        }
      }
    },
    "proof_covered_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sensor_count", "evidence", "commands"],
      "properties": {
        "path": { "type": "string" },
        "sensor_count": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "commands": { "type": "array", "items": { "type": "string" } }
      }
    },
    "proof_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "effect", "expand"],
      "properties": {
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "effect": { "type": "string" },
        "expand": { "type": "string" }
      }
    },
    "proof_wiring_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "subject", "path", "evidence", "effect", "locations", "expand"],
      "properties": {
        "stage": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["missing", "soft", "wired", "validated", "load_bearing", "executed", "unknown"]
        },
        "subject": { "type": "string" },
        "path": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "evidence": { "type": "string" },
        "effect": { "type": "string" },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/evidence_location" } },
        "expand": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "line_start", "reason", "effect", "expand"],
      "properties": {
        "kind": { "type": "string" },
        "path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "reason": { "type": "string" },
        "effect": { "type": "string" },
        "expand": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "verification_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "subject", "object", "path", "evidence", "strength", "locations"],
      "properties": {
        "relation": {
          "type": "string",
          "enum": ["verifies_directly", "verifies_via", "contains_sensor", "related_soft", "supports_verification", "missing_link", "unknown_external", "invokes_process"]
        },
        "subject": { "type": "string" },
        "object": { "type": "string" },
        "path": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/evidence_location" } }
      }
    },
    "verification_horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed", "shown", "hidden", "unknown_external", "reasons", "certificate_id", "expand"],
      "properties": {
        "status": { "type": "string", "enum": ["closed", "open"] },
        "observed": { "type": "integer", "minimum": 0 },
        "shown": { "type": "integer", "minimum": 0 },
        "hidden": { "type": "integer", "minimum": 0 },
        "unknown_external": { "type": "integer", "minimum": 0 },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "certificate_id": { "type": "string", "pattern": "^verification-v1:[0-9a-f]{64}$" },
        "expand": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verification_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct", "mediated", "runnable", "soft_related", "support", "missing_link", "unknown_external", "horizon"],
      "properties": {
        "direct": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "mediated": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "runnable": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "soft_related": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "support": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "missing_link": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "unknown_external": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "horizon": { "$ref": "#/$defs/verification_horizon" }
      }
    }
  }
}
