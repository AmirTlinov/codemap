{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/proof.schema.json",
  "title": "codemap structural proof plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "target",
    "changed",
    "proofs",
    "fallback",
    "unknowns",
    "hidden",
    "expand",
    "run_hint"
  ],
  "properties": {
    "kind": { "const": "proof_plan" },
    "schema_version": { "const": "6" },
    "target": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "proofs": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_surface" }
    },
    "fallback": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknown" }
    },
    "hidden": {
      "type": "array",
      "items": { "$ref": "#/$defs/hidden_group" }
    },
    "expand": {
      "type": "array",
      "items": { "type": "string" }
    },
    "run_hint": { "type": "string" }
  },
  "$defs": {
    "evidence_strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "evidence_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "kind"],
      "properties": {
        "path": { "type": "string" },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "line_end": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "kind": { "type": "string" }
      }
    },
    "proof_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "path",
        "evidence",
        "strength",
        "reason",
        "locations"
      ],
      "properties": {
        "command": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "reason": { "type": "string" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_location" }
        }
      }
    },
    "hidden_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count", "expand"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "expand": { "type": "string" }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "line_start", "reason", "effect", "expand"],
      "properties": {
        "kind": { "type": "string" },
        "path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "reason": { "type": "string" },
        "effect": { "type": "string" },
        "expand": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    }
  }
}
