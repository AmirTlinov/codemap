{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/ctx/schemas/explain.schema.json",
  "title": "ctx explain report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "path",
    "id",
    "domain",
    "roles",
    "risk",
    "risk_reasons",
    "imports",
    "imported_by",
    "exports",
    "related_tests",
    "invariants",
    "files",
    "provenance",
    "confidence",
    "target"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["file", "concept", "missing"]
    },
    "schema_version": { "const": "1" },
    "path": { "$ref": "#/$defs/nullable_string" },
    "id": { "$ref": "#/$defs/nullable_string" },
    "domain": {
      "anyOf": [{ "$ref": "#/$defs/domain_ref" }, { "type": "null" }]
    },
    "roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk": {
      "anyOf": [{ "$ref": "#/$defs/risk" }, { "type": "null" }]
    },
    "risk_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "imports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "imported_by": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_tests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "invariants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": { "type": "string" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "target": { "$ref": "#/$defs/nullable_string" }
  },
  "$defs": {
    "nullable_string": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "medium-high", "high", "critical"]
    },
    "domain_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" }
      }
    }
  }
}
