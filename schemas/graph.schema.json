{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/graph.schema.json",
  "title": "codemap graph lens",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "domain", "lens", "nodes", "edges"],
  "properties": {
    "kind": { "const": "graph_lens" },
    "schema_version": { "const": "2" },
    "domain": { "$ref": "#/$defs/domain_ref" },
    "lens": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/graph_edge" }
    }
  },
  "$defs": {
    "domain_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "graph_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string" }
      }
    }
  }
}
