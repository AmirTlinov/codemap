{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/boundaries.schema.json",
  "title": "codemap boundary report",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "build_identity", "findings"],
  "properties": {
    "kind": { "const": "boundary_report" },
    "schema_version": { "const": "3" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/boundary_finding" }
    }
  },
  "$defs": {
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver",
        "cache_format",
        "schema_manifest_version",
        "executable_path",
        "binary_sha256",
        "binary_sha256_state",
        "source_commit",
        "dirty_build"
      ],
      "properties": {
        "semver": { "type": "string" },
        "cache_format": { "type": "string" },
        "schema_manifest_version": { "type": "integer", "minimum": 1 },
        "executable_path": { "type": "string" },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256_state": {
          "type": "string",
          "enum": ["computed", "not_requested", "unavailable"]
        },
        "source_commit": { "type": ["string", "null"] },
        "dirty_build": { "type": ["boolean", "null"] }
      }
    },
    "strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "boundary_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "status",
        "reason",
        "recovery",
        "provenance",
        "strength"
      ],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["forbidden", "warn", "warning"]
        },
        "reason": { "type": "string" },
        "recovery": {
          "type": "array",
          "items": { "type": "string" }
        },
        "provenance": { "type": "string" },
        "strength": { "$ref": "#/$defs/strength" }
      }
    }
  }
}
