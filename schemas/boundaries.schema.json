{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/boundaries.schema.json",
  "title": "codemap boundary report",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "kind", "schema_version", "build_identity", "findings"],
  "properties": {
    "agent": { "$ref": "#/$defs/agent_envelope" },
    "kind": { "const": "boundary_report" },
    "schema_version": { "const": "4" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/boundary_finding" }
    }
  },
  "$defs": {
    "agent_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "report_kind", "report_version", "result", "scope", "snapshot", "horizon", "expands"],
      "properties": {
        "envelope_version": { "const": "1" },
        "report_kind": { "type": "string", "minLength": 1 },
        "report_version": { "type": "string", "minLength": 1 },
        "result": { "enum": ["success", "valid_empty_map", "invalid_anchor"] },
        "scope": { "type": "object" },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "identities"],
          "properties": {
            "state": { "enum": ["observed", "unavailable"] },
            "identities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        "horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "groups", "reasons", "certificate_count"],
          "properties": {
            "status": { "enum": ["closed", "open", "unavailable", "not_applicable"] },
            "groups": { "type": "integer", "minimum": 0 },
            "reasons": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "certificate_count": { "type": "integer", "minimum": 0 }
          }
        },
        "expands": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "uniqueItems": true
        }
      }
    },
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver",
        "cache_format",
        "schema_manifest_version",
        "executable_path",
        "binary_sha256",
        "binary_sha256_state",
        "source_commit",
        "dirty_build"
      ],
      "properties": {
        "semver": { "type": "string" },
        "cache_format": { "type": "string" },
        "schema_manifest_version": { "type": "integer", "minimum": 1 },
        "executable_path": { "type": "string" },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256_state": {
          "type": "string",
          "enum": ["computed", "not_requested", "unavailable"]
        },
        "source_commit": { "type": ["string", "null"] },
        "dirty_build": { "type": ["boolean", "null"] }
      }
    },
    "strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "boundary_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "status",
        "reason",
        "recovery",
        "provenance",
        "strength"
      ],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["forbidden", "warn", "warning"]
        },
        "reason": { "type": "string" },
        "recovery": {
          "type": "array",
          "items": { "type": "string" }
        },
        "provenance": { "type": "string" },
        "strength": { "$ref": "#/$defs/strength" }
      }
    }
  }
}
