{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/boundaries.schema.json",
  "title": "codemap boundary report",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "findings"],
  "properties": {
    "kind": { "const": "boundary_report" },
    "schema_version": { "const": "2" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/boundary_finding" }
    }
  },
  "$defs": {
    "strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "boundary_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "status",
        "reason",
        "recovery",
        "provenance",
        "strength"
      ],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["forbidden", "warn", "warning"]
        },
        "reason": { "type": "string" },
        "recovery": {
          "type": "array",
          "items": { "type": "string" }
        },
        "provenance": { "type": "string" },
        "strength": { "$ref": "#/$defs/strength" }
      }
    }
  }
}
