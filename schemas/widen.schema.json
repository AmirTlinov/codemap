{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/ctx/schemas/widen.schema.json",
  "title": "ctx widened context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "reason",
    "domain",
    "add",
    "still_do_not_read_yet",
    "confidence",
    "stop_rule"
  ],
  "properties": {
    "kind": { "const": "widened_context" },
    "schema_version": { "const": "1" },
    "reason": { "type": "string" },
    "domain": { "$ref": "#/$defs/domain_ref" },
    "add": {
      "type": "array",
      "items": { "type": "string" }
    },
    "still_do_not_read_yet": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/do_not_read" }
    },
    "confidence": { "$ref": "#/$defs/confidence" },
    "stop_rule": { "type": "string" }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "domain_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "do_not_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
