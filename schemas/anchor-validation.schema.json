{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/anchor-validation.schema.json",
  "title": "codemap anchor validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "build_identity",
    "ok",
    "config",
    "summary",
    "problems",
    "warnings",
    "details"
  ],
  "properties": {
    "kind": { "const": "anchor_validation" },
    "schema_version": { "const": "5" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "ok": { "type": "boolean" },
    "config": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "concepts",
        "role_patterns",
        "forbidden_boundaries",
        "verification_defaults",
        "proof_changed_commands"
      ],
      "properties": {
        "domains": { "type": "integer", "minimum": 0 },
        "concepts": { "type": "integer", "minimum": 0 },
        "role_patterns": { "type": "integer", "minimum": 0 },
        "forbidden_boundaries": { "type": "integer", "minimum": 0 },
        "verification_defaults": { "type": "integer", "minimum": 0 },
        "proof_changed_commands": { "type": "integer", "minimum": 0 }
      }
    },
    "problems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "details": {
      "type": "array",
      "items": { "$ref": "#/$defs/detail" }
    }
  },
  "$defs": {
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver",
        "cache_format",
        "schema_manifest_version",
        "executable_path",
        "binary_sha256",
        "binary_sha256_state",
        "source_commit",
        "dirty_build"
      ],
      "properties": {
        "semver": { "type": "string" },
        "cache_format": { "type": "string" },
        "schema_manifest_version": { "type": "integer", "minimum": 1 },
        "executable_path": { "type": "string" },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256_state": {
          "type": "string",
          "enum": ["computed", "not_requested", "unavailable"]
        },
        "source_commit": { "type": ["string", "null"] },
        "dirty_build": { "type": ["boolean", "null"] }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "status", "message", "next"],
      "properties": {
        "kind": { "type": "string" },
        "id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["ok", "warning", "problem", "info"]
        },
        "message": { "type": "string" },
        "next": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
