{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/ctx/schemas/capsule.schema.json",
  "title": "ctx task context capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "task",
    "domain",
    "task_kind",
    "confidence",
    "risk",
    "read_first",
    "related_tests",
    "source_of_truth",
    "public_boundaries",
    "do_not_read_yet",
    "forbidden_moves",
    "invariants",
    "verification",
    "expansion_triggers",
    "stop_conditions",
    "provenance",
    "cache"
  ],
  "properties": {
    "kind": { "const": "task_context_capsule" },
    "task": { "type": "string" },
    "domain": { "$ref": "#/$defs/domain_ref" },
    "task_kind": { "type": "string" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "risk": { "$ref": "#/$defs/risk" },
    "read_first": {
      "type": "array",
      "maxItems": 7,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "related_tests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_of_truth": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string" }
    },
    "public_boundaries": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string" }
    },
    "do_not_read_yet": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/do_not_read" }
    },
    "forbidden_moves": {
      "type": "array",
      "maxItems": 7,
      "items": { "type": "string" }
    },
    "invariants": {
      "type": "array",
      "maxItems": 7,
      "items": { "type": "string" }
    },
    "verification": { "$ref": "#/$defs/verification_plan" },
    "expansion_triggers": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string" }
    },
    "stop_conditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "cache": { "$ref": "#/$defs/cache_info" }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "medium-high", "high", "critical"]
    },
    "domain_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "score", "reasons"],
      "properties": {
        "path": { "type": "string" },
        "score": { "type": "number" },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "do_not_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "verification_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimal", "recommended", "full_only_if_triggered"],
      "properties": {
        "minimal": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string" }
        },
        "recommended": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string" }
        },
        "full_only_if_triggered": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string" }
        }
      }
    },
    "cache_info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fingerprint"],
      "properties": {
        "path": { "type": "string" },
        "fingerprint": { "type": "string" }
      }
    }
  }
}
