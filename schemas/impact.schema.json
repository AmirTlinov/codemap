{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/impact.schema.json",
  "title": "codemap structural impact report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "build_identity",
    "selector",
    "changed",
    "clusters",
    "hidden",
    "unknowns",
    "expand"
  ],
  "properties": {
    "kind": { "const": "impact_report" },
    "schema_version": { "const": "6" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "selector": { "type": "string" },
    "changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/file_summary" }
    },
    "clusters": {
      "type": "array",
      "items": { "$ref": "#/$defs/impact_cluster" }
    },
    "hidden": {
      "type": "array",
      "items": { "$ref": "#/$defs/hidden_group" }
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknown" }
    },
    "expand": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver",
        "cache_format",
        "schema_manifest_version",
        "executable_path",
        "binary_sha256",
        "binary_sha256_state",
        "source_commit",
        "dirty_build"
      ],
      "properties": {
        "semver": { "type": "string" },
        "cache_format": { "type": "string" },
        "schema_manifest_version": { "type": "integer", "minimum": 1 },
        "executable_path": { "type": "string" },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256_state": {
          "type": "string",
          "enum": ["computed", "not_requested", "unavailable"]
        },
        "source_commit": { "type": ["string", "null"] },
        "dirty_build": { "type": ["boolean", "null"] }
      }
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "evidence_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "kind"],
      "properties": {
        "path": { "type": "string" },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "line_end": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "kind": { "type": "string" }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "exported", "line_start", "line_end"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "exported": { "type": "boolean" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "file_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "package",
        "language",
        "lines",
        "roles",
        "symbols",
        "exports",
        "imports",
        "imported_by"
      ],
      "properties": {
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "package": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "language": { "type": "string" },
        "lines": { "type": "integer", "minimum": 0 },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/symbol" }
        },
        "exports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imported_by": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["counted", "proven_zero", "unknown"] },
            "value": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "structural_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "evidence", "strength", "locations"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string" },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_location" }
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "line_start", "reason", "effect", "expand"],
      "properties": {
        "kind": { "type": "string" },
        "path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "reason": { "type": "string" },
        "effect": { "type": "string" },
        "expand": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "hidden_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count", "expand"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "expand": { "type": "string" }
      }
    },
    "impact_cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "changed",
        "direct_consumers",
        "cross_boundary_consumers",
        "contract_links",
        "proof",
        "reasons"
      ],
      "properties": {
        "id": { "type": "string" },
        "changed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "direct_consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "cross_boundary_consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "contract_links": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "proof": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
