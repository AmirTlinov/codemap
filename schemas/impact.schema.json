{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/impact.schema.json",
  "title": "codemap structural impact report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "changed",
    "clusters",
    "hidden",
    "unknowns",
    "expand"
  ],
  "properties": {
    "kind": { "const": "impact_report" },
    "schema_version": { "const": "2" },
    "changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/file_summary" }
    },
    "clusters": {
      "type": "array",
      "items": { "$ref": "#/$defs/impact_cluster" }
    },
    "hidden": {
      "type": "array",
      "items": { "$ref": "#/$defs/hidden_group" }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expand": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "medium-high", "high", "critical"]
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "exported", "line_start", "line_end"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "exported": { "type": "boolean" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "file_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "package",
        "language",
        "lines",
        "roles",
        "symbols",
        "exports",
        "imports",
        "imported_by_count"
      ],
      "properties": {
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "package": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "language": { "type": "string" },
        "lines": { "type": "integer", "minimum": 0 },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/symbol" }
        },
        "exports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imported_by_count": { "type": "integer", "minimum": 0 }
      }
    },
    "structural_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "evidence", "strength"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string" },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" }
      }
    },
    "hidden_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count", "expand"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "expand": { "type": "string" }
      }
    },
    "impact_cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "risk",
        "changed",
        "direct_consumers",
        "cross_boundary_consumers",
        "contract_risks",
        "proof",
        "reasons"
      ],
      "properties": {
        "id": { "type": "string" },
        "risk": { "$ref": "#/$defs/risk" },
        "changed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "direct_consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "cross_boundary_consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "contract_risks": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "proof": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
