{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/ctx/schemas/impact.schema.json",
  "title": "ctx impact report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "changed",
    "risk",
    "files",
    "impacted",
    "related_tests",
    "domains",
    "external_domains",
    "minimal_verification",
    "recommended_verification",
    "full_verification",
    "expansion_triggers"
  ],
  "properties": {
    "changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk": { "$ref": "#/$defs/risk" },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file_risk" }
    },
    "impacted": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_tests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "domains": {
      "type": "array",
      "items": { "$ref": "#/$defs/domain_ref" }
    },
    "external_domains": {
      "type": "array",
      "items": { "$ref": "#/$defs/domain_ref" }
    },
    "minimal_verification": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "recommended_verification": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "full_verification": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "expansion_triggers": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "medium-high", "high", "critical"]
    },
    "domain_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "file_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "risk", "reasons"],
      "properties": {
        "path": { "type": "string" },
        "risk": { "$ref": "#/$defs/risk" },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
