{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/teach.schema.json",
  "title": "codemap teach report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "build_identity",
    "config",
    "role_patterns",
    "proof_changed",
    "codemap_yml",
    "expand"
  ],
  "properties": {
    "kind": { "const": "teach_report" },
    "schema_version": { "const": "2" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "config": { "type": ["string", "null"] },
    "role_patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/role_pattern" }
    },
    "proof_changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_command" }
    },
    "codemap_yml": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expand": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver",
        "cache_format",
        "schema_manifest_version",
        "executable_path",
        "binary_sha256",
        "binary_sha256_state",
        "source_commit",
        "dirty_build"
      ],
      "properties": {
        "semver": { "type": "string" },
        "cache_format": { "type": "string" },
        "schema_manifest_version": { "type": "integer", "minimum": 1 },
        "executable_path": { "type": "string" },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256_state": {
          "type": "string",
          "enum": ["computed", "not_requested", "unavailable"]
        },
        "source_commit": { "type": ["string", "null"] },
        "dirty_build": { "type": ["boolean", "null"] }
      }
    },
    "role_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "role", "evidence", "matched", "examples"],
      "properties": {
        "pattern": { "type": "string" },
        "role": { "type": "string" },
        "evidence": { "type": "string" },
        "matched": { "type": "integer", "minimum": 0 },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "proof_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "evidence", "source", "line_start"],
      "properties": {
        "command": { "type": "string" },
        "evidence": { "type": "string" },
        "source": { "type": ["string", "null"] },
        "line_start": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
