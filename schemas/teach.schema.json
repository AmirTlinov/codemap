{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/teach.schema.json",
  "title": "codemap teach report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "kind",
    "schema_version",
    "build_identity",
    "config",
    "role_patterns",
    "proof_changed",
    "codemap_yml",
    "expand"
  ],
  "properties": {
    "agent": { "$ref": "#/$defs/agent_envelope" },
    "kind": { "const": "teach_report" },
    "schema_version": { "const": "3" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "config": { "type": ["string", "null"] },
    "role_patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/role_pattern" }
    },
    "proof_changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_command" }
    },
    "codemap_yml": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expand": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "agent_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "report_kind", "report_version", "result", "scope", "snapshot", "horizon", "expands"],
      "properties": {
        "envelope_version": { "const": "1" },
        "report_kind": { "type": "string", "minLength": 1 },
        "report_version": { "type": "string", "minLength": 1 },
        "result": { "enum": ["success", "valid_empty_map", "invalid_anchor"] },
        "scope": { "type": "object" },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "identities"],
          "properties": {
            "state": { "enum": ["observed", "unavailable"] },
            "identities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        "horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "groups", "reasons", "certificate_count"],
          "properties": {
            "status": { "enum": ["closed", "open", "unavailable", "not_applicable"] },
            "groups": { "type": "integer", "minimum": 0 },
            "reasons": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "certificate_count": { "type": "integer", "minimum": 0 }
          }
        },
        "expands": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "uniqueItems": true
        }
      }
    },
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver",
        "cache_format",
        "schema_manifest_version",
        "executable_path",
        "binary_sha256",
        "binary_sha256_state",
        "source_commit",
        "dirty_build"
      ],
      "properties": {
        "semver": { "type": "string" },
        "cache_format": { "type": "string" },
        "schema_manifest_version": { "type": "integer", "minimum": 1 },
        "executable_path": { "type": "string" },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256_state": {
          "type": "string",
          "enum": ["computed", "not_requested", "unavailable"]
        },
        "source_commit": { "type": ["string", "null"] },
        "dirty_build": { "type": ["boolean", "null"] }
      }
    },
    "role_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "role", "evidence", "matched", "examples"],
      "properties": {
        "pattern": { "type": "string" },
        "role": { "type": "string" },
        "evidence": { "type": "string" },
        "matched": { "type": "integer", "minimum": 0 },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "proof_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "evidence", "source", "line_start"],
      "properties": {
        "command": { "type": "string" },
        "evidence": { "type": "string" },
        "source": { "type": ["string", "null"] },
        "line_start": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
