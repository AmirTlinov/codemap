{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/changed.schema.json",
  "title": "codemap changed report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "selector",
    "total_changed_count",
    "changed",
    "git_state",
    "structural_events",
    "map_delta",
    "impact",
    "proof",
    "unknowns",
    "hidden",
    "expand"
  ],
  "properties": {
    "kind": { "const": "changed_report" },
    "schema_version": { "const": "2" },
    "selector": { "type": "string" },
    "total_changed_count": { "type": "integer", "minimum": 0 },
    "changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/file_summary" }
    },
    "git_state": {
      "type": "array",
      "items": { "$ref": "#/$defs/git_change" }
    },
    "structural_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/changed_structural_event" }
    },
    "map_delta": { "$ref": "#/$defs/map_delta" },
    "impact": {
      "type": "array",
      "items": { "$ref": "#/$defs/impact_cluster" }
    },
    "proof": { "$ref": "#/$defs/proof_summary" },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknown" }
    },
    "hidden": {
      "type": "array",
      "items": { "$ref": "#/$defs/hidden_group" }
    },
    "expand": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "evidence_strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "evidence_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "kind"],
      "properties": {
        "path": { "type": "string" },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "line_end": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "kind": { "type": "string" }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "exported", "line_start", "line_end"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "exported": { "type": "boolean" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "file_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "package",
        "language",
        "lines",
        "roles",
        "symbols",
        "exports",
        "imports",
        "imported_by_count"
      ],
      "properties": {
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "package": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "language": { "type": "string" },
        "lines": { "type": "integer", "minimum": 0 },
        "roles": { "type": "array", "items": { "type": "string" } },
        "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol" } },
        "exports": { "type": "array", "items": { "type": "string" } },
        "imports": { "type": "array", "items": { "type": "string" } },
        "imported_by_count": { "type": "integer", "minimum": 0 }
      }
    },
    "git_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "old_path", "status", "staged", "unstaged"],
      "properties": {
        "path": { "type": "string" },
        "old_path": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "status": { "type": "string" },
        "staged": { "type": "boolean" },
        "unstaged": { "type": "boolean" }
      }
    },
    "changed_structural_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "old_path", "evidence", "effect", "locations", "expand"],
      "properties": {
        "kind": { "type": "string" },
        "path": { "type": "string" },
        "old_path": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "evidence": { "type": "string" },
        "effect": { "type": "string" },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/evidence_location" } },
        "expand": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "map_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added_edges",
        "removed_edges",
        "changed_symbols",
        "added_exports",
        "removed_exports",
        "added_runtime_routes",
        "removed_runtime_routes",
        "added_env",
        "removed_env",
        "added_proof_surfaces",
        "removed_proof_surfaces",
        "new_unknowns"
      ],
      "properties": {
        "added_edges": { "type": "integer", "minimum": 0 },
        "removed_edges": { "type": "integer", "minimum": 0 },
        "changed_symbols": { "type": "integer", "minimum": 0 },
        "added_exports": { "type": "integer", "minimum": 0 },
        "removed_exports": { "type": "integer", "minimum": 0 },
        "added_runtime_routes": { "type": "integer", "minimum": 0 },
        "removed_runtime_routes": { "type": "integer", "minimum": 0 },
        "added_env": { "type": "integer", "minimum": 0 },
        "removed_env": { "type": "integer", "minimum": 0 },
        "added_proof_surfaces": { "type": "integer", "minimum": 0 },
        "removed_proof_surfaces": { "type": "integer", "minimum": 0 },
        "new_unknowns": { "type": "integer", "minimum": 0 }
      }
    },
    "structural_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "evidence", "strength", "locations"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string" },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/evidence_location" } }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "role", "evidence", "strength", "count", "examples", "hidden_count"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "path": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "role": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "count": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "examples": { "type": "array", "items": { "type": "string" } },
        "hidden_count": { "type": "integer", "minimum": 0 }
      }
    },
    "proof_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "path", "evidence", "strength", "reason", "locations"],
      "properties": {
        "command": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "path": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "reason": { "type": "string" },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/evidence_location" } }
      }
    },
    "proof_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "sensors", "hidden_count"],
      "properties": {
        "command": { "type": "string" },
        "sensors": { "type": "array", "items": { "$ref": "#/$defs/proof_surface" } },
        "hidden_count": { "type": "integer", "minimum": 0 }
      }
    },
    "proof_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "fallback", "direct", "indirect", "e2e", "contract", "missing_direct"],
      "properties": {
        "commands": { "type": "array", "items": { "$ref": "#/$defs/proof_command" } },
        "fallback": { "type": "array", "items": { "type": "string" } },
        "direct": { "type": "array", "items": { "$ref": "#/$defs/proof_surface" } },
        "indirect": { "type": "array", "items": { "$ref": "#/$defs/proof_surface" } },
        "e2e": { "type": "array", "items": { "$ref": "#/$defs/proof_surface" } },
        "contract": { "type": "array", "items": { "$ref": "#/$defs/proof_surface" } },
        "missing_direct": { "type": "array", "items": { "$ref": "#/$defs/surface" } }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "line_start", "reason", "effect", "expand"],
      "properties": {
        "kind": { "type": "string" },
        "path": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "line_start": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "reason": { "type": "string" },
        "effect": { "type": "string" },
        "expand": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "hidden_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count", "expand"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "expand": { "type": "string" }
      }
    },
    "impact_cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "risk", "changed", "direct_consumers", "cross_boundary_consumers", "contract_risks", "proof", "reasons"],
      "properties": {
        "id": { "type": "string" },
        "risk": { "type": "string" },
        "changed": { "type": "array", "items": { "type": "string" } },
        "direct_consumers": { "type": "array", "items": { "$ref": "#/$defs/structural_edge" } },
        "cross_boundary_consumers": { "type": "array", "items": { "$ref": "#/$defs/structural_edge" } },
        "contract_risks": { "type": "array", "items": { "$ref": "#/$defs/structural_edge" } },
        "proof": { "type": "array", "items": { "$ref": "#/$defs/structural_edge" } },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
