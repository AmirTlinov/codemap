{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/cone.schema.json",
  "title": "codemap structural cone report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "anchor",
    "depth",
    "declared_env",
    "outgoing",
    "incoming",
    "proof",
    "contracts",
    "boundary",
    "hidden",
    "unknowns",
    "expand"
  ],
  "properties": {
    "kind": { "const": "cone_report" },
    "schema_version": { "const": "4" },
    "anchor": { "$ref": "#/$defs/file_summary" },
    "depth": { "type": "integer", "minimum": 0 },
    "declared_env": {
      "type": "array",
      "items": { "$ref": "#/$defs/env_declaration" }
    },
    "outgoing": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_edge" }
    },
    "incoming": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_edge" }
    },
    "proof": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_edge" }
    },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_edge" }
    },
    "boundary": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_edge" }
    },
    "hidden": {
      "type": "array",
      "items": { "$ref": "#/$defs/hidden_group" }
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknown" }
    },
    "expand": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "evidence_strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "evidence_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "kind"],
      "properties": {
        "path": { "type": "string" },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "line_end": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "kind": { "type": "string" }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "exported", "line_start", "line_end"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "exported": { "type": "boolean" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "env_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "path", "line_start"],
      "properties": {
        "key": { "type": "string" },
        "path": { "type": "string" },
        "line_start": { "type": "integer", "minimum": 1 }
      }
    },
    "file_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "package",
        "language",
        "lines",
        "roles",
        "symbols",
        "exports",
        "imports",
        "imported_by_count"
      ],
      "properties": {
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "package": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "language": { "type": "string" },
        "lines": { "type": "integer", "minimum": 0 },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/symbol" }
        },
        "exports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imported_by_count": { "type": "integer", "minimum": 0 }
      }
    },
    "structural_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "evidence", "strength", "locations"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string" },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_location" }
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "line_start", "reason", "effect", "expand"],
      "properties": {
        "kind": { "type": "string" },
        "path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "reason": { "type": "string" },
        "effect": { "type": "string" },
        "expand": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "hidden_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count", "expand"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "expand": { "type": "string" }
      }
    }
  }
}
