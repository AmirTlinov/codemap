{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/cone.schema.json",
  "title": "codemap structural cone report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "build_identity",
    "prelude",
    "anchor",
    "depth",
    "xray",
    "declared_env",
    "outgoing",
    "incoming",
    "proof",
    "contracts",
    "boundary",
    "hidden",
    "unknowns",
    "expand"
  ],
  "properties": {
    "kind": { "const": "cone_report" },
    "schema_version": { "const": "9" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "prelude": { "$ref": "#/$defs/map_prelude" },
    "anchor": { "$ref": "#/$defs/file_summary" },
    "depth": { "type": "integer", "minimum": 0 },
    "xray": { "$ref": "#/$defs/xray_card" },
    "declared_env": {
      "type": "array",
      "items": { "$ref": "#/$defs/env_declaration" }
    },
    "outgoing": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_edge" }
    },
    "incoming": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_edge" }
    },
    "proof": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_edge" }
    },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_edge" }
    },
    "boundary": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_edge" }
    },
    "hidden": {
      "type": "array",
      "items": { "$ref": "#/$defs/hidden_group" }
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknown" }
    },
    "expand": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver",
        "cache_format",
        "schema_manifest_version",
        "executable_path",
        "binary_sha256",
        "binary_sha256_state",
        "source_commit",
        "dirty_build"
      ],
      "properties": {
        "semver": { "type": "string" },
        "cache_format": { "type": "string" },
        "schema_manifest_version": { "type": "integer", "minimum": 1 },
        "executable_path": { "type": "string" },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256_state": {
          "type": "string",
          "enum": ["computed", "not_requested", "unavailable"]
        },
        "source_commit": { "type": ["string", "null"] },
        "dirty_build": { "type": ["boolean", "null"] }
      }
    },
    "map_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "cwd", "cwd_rel", "git_root", "vcs", "head", "branch", "remote", "worktree", "freshness", "unknowns"],
      "properties": {
        "root": { "type": "string" },
        "cwd": { "type": "string" },
        "cwd_rel": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "git_root": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "vcs": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "head": { "$ref": "#/$defs/head_prelude" },
        "branch": { "$ref": "#/$defs/branch_prelude" },
        "remote": { "$ref": "#/$defs/remote_prelude" },
        "worktree": { "$ref": "#/$defs/worktree_prelude" },
        "freshness": { "$ref": "#/$defs/freshness_prelude" },
        "unknowns": { "type": "array", "items": { "$ref": "#/$defs/prelude_unknown" } }
      }
    },
    "head_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oid", "short", "detached", "unborn"],
      "properties": {
        "oid": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "short": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "detached": { "type": "boolean" },
        "unborn": { "type": "boolean" }
      }
    },
    "branch_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "upstream", "upstream_gone", "ahead", "behind"],
      "properties": {
        "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "upstream": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "upstream_gone": { "type": "boolean" },
        "ahead": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "behind": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },
    "remote_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display", "sanitized_url"],
      "properties": {
        "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "display": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "sanitized_url": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "worktree_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "staged", "unstaged", "untracked", "conflicted", "renamed", "deleted", "typechanged"],
      "properties": {
        "clean": { "type": "boolean" },
        "staged": { "type": "integer", "minimum": 0 },
        "unstaged": { "type": "integer", "minimum": 0 },
        "untracked": { "type": "integer", "minimum": 0 },
        "conflicted": { "type": "integer", "minimum": 0 },
        "renamed": { "type": "integer", "minimum": 0 },
        "deleted": { "type": "integer", "minimum": 0 },
        "typechanged": { "type": "integer", "minimum": 0 }
      }
    },
    "freshness_prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_used", "remote_refs", "remote_currentness", "fetch_head_mtime", "evidence"],
      "properties": {
        "network_used": { "type": "boolean" },
        "remote_refs": { "type": "string", "enum": ["local_only", "not_applicable"] },
        "remote_currentness": { "type": "string", "enum": ["unknown"] },
        "fetch_head_mtime": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "prelude_unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "effect"],
      "properties": {
        "kind": { "type": "string" },
        "effect": { "type": "string" }
      }
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["low", "medium", "high", "hard"]
    },
    "evidence_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "kind"],
      "properties": {
        "path": { "type": "string" },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "line_end": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "kind": { "type": "string" }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "exported", "line_start", "line_end"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "exported": { "type": "boolean" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "env_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "path", "line_start"],
      "properties": {
        "key": { "type": "string" },
        "path": { "type": "string" },
        "line_start": { "type": "integer", "minimum": 1 }
      }
    },
    "file_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "package",
        "language",
        "lines",
        "roles",
        "symbols",
        "exports",
        "imports",
        "imported_by"
      ],
      "properties": {
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "package": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "language": { "type": "string" },
        "lines": { "type": "integer", "minimum": 0 },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/symbol" }
        },
        "exports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imported_by": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["counted", "proven_zero", "unknown"] },
            "value": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "structural_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "evidence", "strength", "locations"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string" },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_location" }
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "role",
        "evidence",
        "strength",
        "count",
        "examples",
        "hidden_count"
      ],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "role": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "count": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hidden_count": { "type": "integer", "minimum": 0 }
      }
    },
    "flow_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "anchor", "kind", "evidence", "locations"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "anchor": { "type": "string" },
        "kind": { "type": "string" },
        "evidence": { "type": "string" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_location" }
        }
      }
    },
    "xray_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "inputs",
        "outputs",
        "state",
        "side_effects",
        "direct_consumers",
        "mediated_consumers",
        "flow",
        "nearby",
        "proof_hard",
        "proof_direct",
        "proof_mediated",
        "proof_soft",
        "unknowns"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        },
        "state": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        },
        "side_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        },
        "direct_consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "mediated_consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "flow": {
          "type": "array",
          "items": { "$ref": "#/$defs/flow_step" }
        },
        "nearby": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        },
        "proof_hard": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "proof_direct": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "proof_mediated": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "proof_soft": {
          "type": "array",
          "items": { "$ref": "#/$defs/structural_edge" }
        },
        "unknowns": {
          "type": "array",
          "items": { "$ref": "#/$defs/unknown" }
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "line_start", "reason", "effect", "expand"],
      "properties": {
        "kind": { "type": "string" },
        "path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "line_start": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "reason": { "type": "string" },
        "effect": { "type": "string" },
        "expand": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "hidden_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count", "expand"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "expand": { "type": "string" }
      }
    }
  }
}
