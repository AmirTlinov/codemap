{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmirTlinov/codemap/schemas/proof-map.schema.json",
  "title": "codemap proof-map report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "build_identity",
    "selector",
    "scope",
    "changed",
    "hard",
    "direct_evidence",
    "mediated_evidence",
    "soft_evidence",
    "setup_support",
    "missing_direct",
    "commands",
    "wiring",
    "verification_topology",
    "fallback",
    "unknowns",
    "hidden",
    "expand"
  ],
  "properties": {
    "kind": {
      "const": "proof_map_report"
    },
    "schema_version": { "const": "7" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "selector": {
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hard": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof_surface"
      }
    },
    "direct_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof_surface"
      }
    },
    "mediated_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof_surface"
      }
    },
    "soft_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof_surface"
      }
    },
    "setup_support": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof_surface"
      }
    },
    "missing_direct": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof_surface"
      }
    },
    "fallback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "hidden": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hidden_group"
      }
    },
    "expand": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wiring": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof_wiring_fact"
      }
    },
    "verification_topology": {
      "$ref": "#/$defs/verification_topology"
    }
  },
  "$defs": {
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver",
        "cache_format",
        "schema_manifest_version",
        "executable_path",
        "binary_sha256",
        "binary_sha256_state",
        "source_commit",
        "dirty_build"
      ],
      "properties": {
        "semver": { "type": "string" },
        "cache_format": { "type": "string" },
        "schema_manifest_version": { "type": "integer", "minimum": 1 },
        "executable_path": { "type": "string" },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256_state": {
          "type": "string",
          "enum": ["computed", "not_requested", "unavailable"]
        },
        "source_commit": { "type": ["string", "null"] },
        "dirty_build": { "type": ["boolean", "null"] }
      }
    },
    "evidence_strength": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "hard"
      ]
    },
    "evidence_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line_start",
        "line_end",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "exported",
        "line_start",
        "line_end"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "exported": {
          "type": "boolean"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "file_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "package",
        "language",
        "lines",
        "roles",
        "symbols",
        "exports",
        "imports",
        "imported_by"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "package": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "type": "string"
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imported_by": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["counted", "proven_zero", "unknown"] },
            "value": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "role",
        "evidence",
        "strength",
        "count",
        "examples",
        "hidden_count"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "string"
        },
        "strength": {
          "$ref": "#/$defs/evidence_strength"
        },
        "count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hidden_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "structural_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "type",
        "evidence",
        "strength",
        "locations"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "strength": {
          "$ref": "#/$defs/evidence_strength"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_location"
          }
        }
      }
    },
    "hidden_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "count",
        "expand"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "expand": {
          "type": "string"
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "line_start",
        "reason",
        "effect",
        "expand"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        },
        "expand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "proof_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "path",
        "target_anchor",
        "evidence",
        "strength",
        "reason",
        "locations"
      ],
      "properties": {
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "string"
        },
        "strength": {
          "$ref": "#/$defs/evidence_strength"
        },
        "reason": {
          "type": "string"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_location"
          }
        }
      }
    },
    "package_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "from_manifest",
        "to",
        "to_manifest",
        "workspace_manifest",
        "dependency",
        "dependency_kind",
        "source"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "from_manifest": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "to_manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace_manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependency": {
          "type": "string"
        },
        "dependency_kind": {
          "enum": [
            "runtime",
            "dev",
            "build",
            "peer",
            "optional"
          ]
        },
        "source": {
          "type": "string"
        }
      }
    },
    "domain_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "boundary_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "status",
        "reason",
        "recovery",
        "provenance",
        "strength"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "recovery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "string"
        },
        "strength": {
          "type": "string"
        }
      }
    },
    "changed_symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "name",
        "change",
        "line_start",
        "line_end"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "change": {
          "type": "string"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "runtime_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "file",
        "handler_symbol",
        "evidence",
        "strength",
        "locations"
      ],
      "properties": {
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "handler_symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "string"
        },
        "strength": {
          "$ref": "#/$defs/evidence_strength"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_location"
          }
        }
      }
    },
    "env_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "used_by",
        "declaration",
        "evidence",
        "strength",
        "locations"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "used_by": {
          "type": "string"
        },
        "declaration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "string"
        },
        "strength": {
          "$ref": "#/$defs/evidence_strength"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_location"
          }
        }
      }
    },
    "flow_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "anchor",
        "kind",
        "evidence",
        "locations"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "anchor": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_location"
          }
        }
      }
    },
    "proof_wiring_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "status",
        "subject",
        "path",
        "evidence",
        "effect",
        "locations",
        "expand"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "missing",
            "soft",
            "wired",
            "validated",
            "load_bearing",
            "executed",
            "unknown"
          ]
        },
        "subject": {
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_location"
          }
        },
        "expand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "verification_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "subject", "object", "path", "evidence", "strength", "locations"],
      "properties": {
        "relation": {
          "type": "string",
          "enum": ["verifies_directly", "verifies_via", "contains_sensor", "related_soft", "supports_verification", "missing_link", "unknown_external", "invokes_process"]
        },
        "subject": { "type": "string" },
        "object": { "type": "string" },
        "path": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "evidence": { "type": "string" },
        "strength": { "$ref": "#/$defs/evidence_strength" },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/evidence_location" } }
      }
    },
    "verification_horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed", "shown", "hidden", "unknown_external", "reasons", "certificate_id", "expand"],
      "properties": {
        "status": { "type": "string", "enum": ["closed", "open"] },
        "observed": { "type": "integer", "minimum": 0 },
        "shown": { "type": "integer", "minimum": 0 },
        "hidden": { "type": "integer", "minimum": 0 },
        "unknown_external": { "type": "integer", "minimum": 0 },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "certificate_id": { "type": "string", "pattern": "^verification-v1:[0-9a-f]{64}$" },
        "expand": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verification_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct", "mediated", "runnable", "soft_related", "support", "missing_link", "unknown_external", "horizon"],
      "properties": {
        "direct": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "mediated": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "runnable": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "soft_related": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "support": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "missing_link": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "unknown_external": { "type": "array", "items": { "$ref": "#/$defs/verification_relation" } },
        "horizon": { "$ref": "#/$defs/verification_horizon" }
      }
    }
  }
}
